# Aiven for PostgreSQL service URI (Aiven console > service > Overview > Service URI)
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# Optional: CA certificate content of the Aiven project for strict TLS verification
# DATABASE_CA=
# Optional: enables the Claude review step (tool-use loop). Without it a template brief is used.
# ANTHROPIC_API_KEY=
PORT=8080
AGENT_EVERY_MIN=5
HORIZON_MIN=30
